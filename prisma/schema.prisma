generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                @id @default(cuid())
  email         String                @unique
  passwordHash  String
  name          String?
  phone         String?
  avatar        String?
  address       String?
  role          Role                  @default(CUSTOMER)
  isVerified    Boolean               @default(false)
  isBlocked     Boolean               @default(false)
  orders        Order[]
  sentMessages  Message[]             @relation("sender")
  chatRooms     ChatRoomParticipant[]
  notifications Notification[]
  reviews       Review[]
  wishlists     Wishlist[]
  couponUsages  CouponUsage[]
  wallet        UserWallet?
  staffPermissions   StaffPermission[]     @relation("UserPermissions")
  grantedPermissions StaffPermission[]     @relation("GrantedPermissions")
  reviewedDataSources DataSource[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model StaffPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String
  grantedBy  String
  grantedAt  DateTime @default(now())

  user       User     @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  granter    User     @relation("GrantedPermissions", fields: [grantedBy], references: [id])

  @@unique([userId, permission])
  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      OtpType  @default(REGISTRATION)
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

enum OtpType {
  REGISTRATION
  PASSWORD_RESET
}

model Product {
  id              String           @id @default(cuid())
  name            String
  description     String?
  price           BigInt
  image           String?
  category        String?
  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id])
  categoryId      String?
  categoryRef     Category?        @relation(fields: [categoryId], references: [id])
  kind            ProductKind      @default(LEGACY)
  segment         ProductSegment?
  isLegacy        Boolean          @default(false)
  specs           Json?
  images          Json?
  editorialTags   Json?
  warrantyConfig  Json?
  catalogVersion  Int              @default(1)
  stock           Int              @default(0)
  stockVersion    Int              @default(0)
  weightGrams     Int?
  lengthCm        Int?
  widthCm         Int?
  heightCm        Int?
  isActive        Boolean          @default(true)
  inventoryMode   InventoryMode    @default(BASE)
  orderItems      OrderItem[]
  variants        ProductVariant[]
  reviews         Review[]
  wishlists       Wishlist[]
  benchmarks      BenchmarkMeasurement[]
  scoreSnapshots  ProductScoreSnapshot[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive, category])
  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([kind, segment, isActive])
  @@index([createdAt])
}

enum InventoryMode {
  BASE
  VARIANT
}

model ProductVariant {
  id                    String      @id @default(cuid())
  productId             String
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                   String      @unique
  title                 String
  color                 String?
  size                  String?
  price                 BigInt
  stock                 Int         @default(0)
  stockVersion          Int         @default(0)
  weightGrams           Int?
  lengthCm              Int?
  widthCm               Int?
  heightCm              Int?
  image                 String?
  optionValues          Json?
  optionHash            String?
  specOverrides         Json?
  images                Json?
  warrantyConfig        Json?
  serializationRequired Boolean     @default(false)
  isActive              Boolean     @default(true)
  orderItems            OrderItem[]
  benchmarks            BenchmarkMeasurement[]
  scoreSnapshots        ProductScoreSnapshot[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([productId, optionHash])
  @@index([productId])
  @@index([productId, isActive])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  country     String?
  websiteUrl  String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model Category {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  kind              ProductKind @default(LEGACY)
  parentId          String?
  parent            Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children          Category[]  @relation("CategoryHierarchy")
  specSchema        Json
  specSchemaVersion Int         @default(1)
  scoringConfig     Json?
  warrantyConfig    Json?
  isActive          Boolean     @default(true)
  products          Product[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([parentId])
  @@index([kind, isActive])
}

model DataSource {
  id              String         @id @default(cuid())
  name            String
  sourceType      DataSourceType
  status          SourceStatus   @default(DISCOVERED)
  publisher       String
  url             String?
  license         String?
  market          String?
  version         String?
  checksum        String?
  isSynthetic     Boolean        @default(false)
  reviewerId      String?
  reviewer        User?          @relation(fields: [reviewerId], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  payload         Json?
  benchmarks      BenchmarkMeasurement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([sourceType, status])
  @@index([status])
}

model BenchmarkMeasurement {
  id          String          @id @default(cuid())
  sourceId    String
  source      DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  metric      String
  value       Float
  unit        String
  methodology String?
  measuredAt  DateTime?
  version     Int             @default(1)
  sampleSize  Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([sourceId, productId, variantId, metric, version])
  @@index([productId, metric])
  @@index([sourceId])
}

model ProductScoreSnapshot {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  useCase         String
  finalScore      Float
  priceEfficiency Float
  experience      Float
  support         Float
  coverage        Float
  status          String          @default("ACTIVE")
  isGoodValue     Boolean         @default(false)
  rubricVersion   Int             @default(1)
  rubricSnapshot  Json
  breakdown       Json
  sourceRefs      Json
  missingEvidence Json?
  sourceSetHash   String
  priceSnapshot   String
  revisionKey     String          @unique
  publishedAt     DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([productId, useCase, status])
  @@index([isGoodValue, status])
  @@index([publishedAt])
}

enum ProductKind {
  LAPTOP
  PHONE
  ACCESSORY
  LEGACY
}

enum ProductSegment {
  BUDGET
  MID_RANGE
  PREMIUM
  FLAGSHIP
}

enum SourceStatus {
  DISCOVERED
  LICENSE_REVIEW
  MAPPING_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  REVOKED
}

enum DataSourceType {
  CATALOG
  REVIEW_AGGREGATE
  BENCHMARK
  COMPATIBILITY
  MANUFACTURER
}

model StockAdjustment {
  id            String   @id @default(cuid())
  operationKey  String   @unique
  productId     String
  variantId     String?
  delta         Int
  previousStock Int
  newStock      Int
  version       Int
  reason        String
  actorId       String
  createdAt     DateTime @default(now())

  @@index([productId, variantId])
  @@index([createdAt])
}

model Order {
  id              String        @id @default(cuid())
  orderCode       String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String
  toDistrictId    Int?
  toWardCode      String?
  items           OrderItem[]
  totalAmount     BigInt
  subtotal        BigInt        @default(0)
  discountAmount  BigInt        @default(0)
  shippingFee     BigInt        @default(0)
  couponId        String?
  couponCode      String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  transaction     Transaction?
  chatRoom        ChatRoom?
  shipment        Shipment?
  bankTransfers   BankTransfer[]
  refundCases     RefundCase[]
  fulfillmentState         FulfillmentState @default(NONE)
  manualFulfillmentOutcome String?
  customerConsentRef       String?
  packingSnapshot          Json?
  packingRevision          String?
  qrContent                String?
  note            String?
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, paymentStatus, expiresAt])
  @@index([status, completedAt])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  EXPIRED
  REFUNDED
}

enum FulfillmentState {
  NONE
  REQUESTING
  REVIEW
  CREATED
}

enum BankTransferStatus {
  PENDING_REVIEW
  APPLIED_ORDER
  APPLIED_TOPUP
  REFUNDED
}

model BankTransfer {
  id              String             @id @default(cuid())
  fingerprint     String             @unique
  bankTransId     String?            @unique
  amount          BigInt
  description     String
  bankName        String?
  receivedAt      DateTime?
  rawWebhookData  Json
  orderId         String?
  order           Order?             @relation(fields: [orderId], references: [id])
  topupCode       String?
  status          BankTransferStatus @default(PENDING_REVIEW)
  reviewReason    String?
  reviewedById    String?
  reviewedAt      DateTime?
  resolutionNote  String?
  refundCase      RefundCase?
  createdAt       DateTime           @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

enum RefundCaseStatus {
  OPEN
  COMPLETED
}

model RefundCase {
  id               String           @id @default(cuid())
  sourceKey        String           @unique
  orderId          String?
  order            Order?           @relation(fields: [orderId], references: [id])
  bankTransferId   String?          @unique
  bankTransfer     BankTransfer?    @relation(fields: [bankTransferId], references: [id])
  amount           BigInt
  reason           String
  status           RefundCaseStatus @default(OPEN)
  resolvedById     String?
  resolutionNote   String?
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([status, createdAt])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id])
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  variantId           String?
  variantTitle        String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  quantity            Int
  price               BigInt
  productName         String?
  sku                 String?
  variantOptions      Json?
  unitPrice           BigInt?
  warrantySnapshot    Json?
  packingLineSnapshot Json?
  schemaRevision      Int?
  sourceRevision      String?
  returnedQuantity    Int             @default(0)

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  description    String?
  discountType        DiscountType
  discountValue       Int
  fixedDiscountAmount BigInt?
  percentageRate      Int?
  maxDiscount         BigInt?
  minOrderAmount BigInt        @default(0)
  usageLimit     Int           @default(100)
  usedCount      Int           @default(0)
  perUserLimit   Int           @default(1)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean       @default(true)
  orders         Order[]
  userUsages     CouponUsage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum DiscountType {
  FIXED
  PERCENTAGE
  FREE_SHIPPING
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String
  createdAt DateTime @default(now())

  @@unique([couponId, userId, orderId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String
  rating     Int
  comment    String?
  images     String[]
  reply      String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([productId, userId, orderId])
  @@index([productId, isApproved, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Transaction {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id])
  bankTransId    String?   @unique
  amount         BigInt
  description    String
  bankName       String?
  senderAccount  String?
  receivedAt     DateTime?
  verified       Boolean   @default(false)
  rawWebhookData Json?
  createdAt      DateTime  @default(now())
}

model ChatRoom {
  id           String                @id @default(cuid())
  orderId      String?               @unique
  order        Order?                @relation(fields: [orderId], references: [id])
  participants ChatRoomParticipant[]
  messages     Message[]
  lastMessage  String?
  lastActiveAt DateTime              @default(now())
  createdAt    DateTime              @default(now())

  @@index([lastActiveAt])
}

model ChatRoomParticipant {
  id         String   @id @default(cuid())
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([roomId, userId])
}

model Message {
  id        String      @id @default(cuid())
  roomId    String
  room      ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation("sender", fields: [senderId], references: [id])
  content   String
  type      MessageType @default(TEXT)
  imageUrl  String?
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([roomId, createdAt])
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  ORDER_SHIPPING
  ORDER_COMPLETED
  NEW_MESSAGE
  OTP_SENT
}

// ==========================================
// MỞ RỘNG TRỤ CỘT 2: LOGISTICS AUTOMATION
// ==========================================

model Shipment {
  id               String         @id @default(cuid())
  orderId          String         @unique
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier          CarrierName    @default(GHN)
  trackingCode     String         @unique
  shippingFee      BigInt
  codAmount        BigInt         @default(0)
  weightGrams      Int?
  status           ShipmentStatus @default(READY_TO_PICK)
  estimatedArrival DateTime?
  shippingLogs     Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum CarrierName {
  GHN
  GHTK
  VIETTEL_POST
}

enum ShipmentStatus {
  READY_TO_PICK
  PICKING
  DELIVERING
  DELIVERED
  RETURNED
  CANCELLED
}

// ==========================================
// MỞ RỘNG TRỤ CỘT 3: VÍ NỘI BỘ & HOÀN TIỀN
// ==========================================

model UserWallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      BigInt              @default(0)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  wallet      UserWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      BigInt
  type        WalletTxType
  orderId     String?
  description String
  createdAt   DateTime     @default(now())

  @@index([walletId, createdAt])
}

enum WalletTxType {
  REFUND
  PURCHASE_PAYMENT
  TOPUP
}

