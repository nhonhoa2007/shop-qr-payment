{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ElectronicsCatalogManifest",
  "description": "Versioned, license-gated electronics catalog manifest for Shop QR Payment M7 Release.",
  "type": "object",
  "required": [
    "version",
    "manifestVersion",
    "sources",
    "brands",
    "categories",
    "products"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "manifestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sourceType",
          "publisher",
          "url",
          "license",
          "version",
          "checksum",
          "isSynthetic"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sourceType": {
            "type": "string",
            "enum": ["MANUFACTURER", "CATALOG", "BENCHMARK", "COMMUNITY"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "REVOKED", "QUARANTINED", "PENDING"]
          },
          "publisher": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" },
          "version": { "type": "string" },
          "checksum": { "type": "string" },
          "isSynthetic": { "type": "boolean" },
          "payload": { "type": "object" }
        }
      }
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "slug", "country", "websiteUrl", "isActive"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "country": { "type": "string" },
          "websiteUrl": { "type": "string" },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "kind",
          "specSchemaVersion",
          "specSchema",
          "warrantyConfig",
          "isActive"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["LAPTOP", "PHONE", "ACCESSORY"]
          },
          "specSchemaVersion": { "type": "integer" },
          "specSchema": { "type": "object" },
          "warrantyConfig": { "type": "object" },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 40,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "brandId",
          "categoryId",
          "kind",
          "weight",
          "length",
          "width",
          "height",
          "specs",
          "variants"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "brandId": { "type": "string" },
          "categoryId": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["LAPTOP", "PHONE", "ACCESSORY"]
          },
          "segment": {
            "type": ["string", "null"],
            "enum": ["BUDGET", "ENTRY", "MID", "HIGH", "FLAGSHIP", "PREMIUM", "PRO", null]
          },
          "weight": { "type": "number" },
          "length": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "specs": { "type": "object" },
          "warrantyConfig": { "type": "object" },
          "images": { "type": "array" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sku", "title", "price", "stock", "optionValues"],
              "properties": {
                "sku": { "type": "string" },
                "title": { "type": "string" },
                "price": { "type": "number" },
                "stock": { "type": "integer", "minimum": 0 },
                "color": { "type": "string" },
                "size": { "type": "string" },
                "optionValues": { "type": "object" },
                "specOverrides": { "type": "object" }
              }
            }
          },
          "sourceIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "origin": { "type": "string" },
          "licenseNotice": { "type": "string" }
        }
      }
    }
  }
}
