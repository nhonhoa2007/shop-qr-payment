classDiagram
    direction TB

    %% ─── Bounded Context 1: Core Commerce & Identity (18 Models) ───
    class User {
        +String id
        +String email
        +String passwordHash
        +String name
        +String phone
        +Role role
        +Boolean isVerified
        +Boolean isBlocked
        +DateTime createdAt
    }

    class StaffPermission {
        +String id
        +String userId
        +String permission
        +DateTime grantedAt
    }

    class OtpCode {
        +String id
        +String email
        +String code
        +OtpType type
        +Boolean used
        +Int attempts
        +DateTime expiresAt
    }

    class Product {
        +String id
        +String name
        +String slug
        +String description
        +BigInt price
        +Int stock
        +ProductKind kind
        +ProductSegment segment
        +Json specs
        +Json images
        +Json warrantyConfig
        +Boolean isActive
    }

    class ProductVariant {
        +String id
        +String productId
