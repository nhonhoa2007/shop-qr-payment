# Database
DATABASE_URL="postgresql://user:***@localhost:5432/shopqr?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Resend (Email OTP)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Shop QR <noreply@yourdomain.com>"

# Cron Job (Bắt buộc cho production - fail-closed nếu thiếu)
CRON_SECRET="your-cron-secret-here"

# Bank / VietQR
BANK_ID="mbbank"
BANK_ACCOUNT="0123456789"
BANK_NAME="NGUYEN VAN A"
BANK_DISPLAY_NAME="MB Bank"

# Casso Webhook
CASSO_WEBHOOK_SECRET="your-casso-secret"

# Pusher
PUSHER_APP_ID="your-pusher-app-id"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Logistics (GHN OpenAPI v2)
# Token dev dùng gateway dev mặc định; nếu dùng token production thì trỏ GHN_API_BASE_URL
# về https://online-gateway.ghn.vn/shiip/public-api/
GHN_TOKEN="your-ghn-token"
GHN_API_BASE_URL="https://dev-online-gateway.ghn.vn/shiip/public-api/"
GHN_WEBHOOK_TOKEN="your-ghn-webhook-token"
GHN_SHOP_ID="your-ghn-shop-id"
GHN_FROM_DISTRICT_ID=1442
GHN_FROM_WARD_CODE="20101"

# Upstash Redis (Distributed Cache & Serverless Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret-token"

# Commerce Intelligence & AI Assistant (M3)
AI_DEFAULT_MODEL="ag/gemini-3.8-flash-high"
AI_PROVIDER="fake" # 'fake' for offline eval and tests, or configure AI_API_BASE_URL & AI_API_KEY for custom LLM
AI_API_BASE_URL="https://api.openai.com/v1" # Custom OpenAI-compatible endpoint (api/v1)
AI_API_KEY="" # Your API key for the external AI provider
AI_MODEL_NAME="" # Optional override model name (e.g. gpt-4o-mini, claude-3-5-sonnet, etc.)
AI_TIMEOUT_MS="20000" # Timeout in ms for external AI generation
AI_MAX_TOKENS_PER_REQUEST=1000
AI_HOURLY_IP_REQUEST_LIMIT=30
AI_HOURLY_USER_REQUEST_LIMIT=60
AI_GLOBAL_HOURLY_REQUEST_LIMIT=500

