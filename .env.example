# Database
DATABASE_URL="postgresql://user:***@localhost:5432/shopqr?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Tạo Client ID & Secret tại https://console.cloud.google.com/apis/credentials)
# Thêm Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (Email OTP)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Shop QR <noreply@yourdomain.com>"

# Cron Job (Bắt buộc cho production - fail-closed nếu thiếu)
CRON_SECRET="your-cron-secret-here"

# Bank / VietQR
BANK_ID="mbbank"
BANK_ACCOUNT="0123456789"
BANK_NAME="NGUYEN VAN A"
BANK_DISPLAY_NAME="MB Bank"

# Casso Webhook
CASSO_WEBHOOK_SECRET="your-casso-secret"

# Pusher
PUSHER_APP_ID="your-pusher-app-id"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Logistics (GHN OpenAPI v2)
GHN_TOKEN="your-ghn-token"
GHN_SHOP_ID="your-ghn-shop-id"
GHN_FROM_DISTRICT_ID=1442
GHN_FROM_WARD_CODE="20101"

# PayOS Payment Gateway
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# Upstash Redis (Distributed Cache & Serverless Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

